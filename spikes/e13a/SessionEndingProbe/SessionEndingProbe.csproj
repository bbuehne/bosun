<Project Sdk="Microsoft.NET.Sdk">

  <!--
    E13a spike (bs-vqh.1), ADR-021 assumption 8. NOT part of Bosun.sln.
    Logs SystemEvents.SessionEnding / SessionEnded against the lifetime of Windows Terminal,
    claude and node processes. Throwaway: do not reuse this code in Bosun.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SessionEndingProbe</AssemblyName>
    <RootNamespace>SessionEndingProbe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
  </ItemGroup>

</Project>
