<Window x:Class="Bosun.UI.HostEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Host" Width="480" MinWidth="420" SizeToContent="Height" MinHeight="200"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/bosun.ico">
    <Window.Resources>
        <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0392B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>
    <!--
        bs-ww9.8 / ADR-019: add/edit one host. Chrome only: every field's parsing, defaulting,
        the I6/I7 floors, and the dependent-field enable rules live in HostEditorController, which
        is unit-tested without this window (CLAUDE.md: no default-suite test constructs a WPF
        Window). This file wires named controls to that controller and does no logic of its own
        beyond enabling/disabling controls, which is why it is left untested per the XAML/layout
        carve-out.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel Margin="16">

            <TextBlock x:Name="ErrorSummaryTextBlock"
                       Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <TextBlock Text="Connection" FontWeight="Bold" Margin="0,0,0,4" />

            <TextBlock Text="Short name"
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,2" FontSize="11" />
            <TextBox x:Name="KeyTextBox" Margin="0,0,0,2" />
            <TextBlock x:Name="KeyError" Style="{StaticResource FieldErrorStyle}" />

            <TextBlock Text="Display name (shown in Bosun and as the Terminal profile name)" Margin="0,8,0,2" />
            <TextBox x:Name="DisplayNameTextBox" />
            <TextBlock x:Name="DisplayNameError" Style="{StaticResource FieldErrorStyle}" />

            <TextBlock Text="Hostname or IP address" Margin="0,8,0,2" />
            <TextBox x:Name="HostnameTextBox" />
            <TextBlock x:Name="HostnameError" Style="{StaticResource FieldErrorStyle}" />

            <TextBlock Text="Port" Margin="0,8,0,2" />
            <TextBox x:Name="PortTextBox" />
            <TextBlock x:Name="PortError" Style="{StaticResource FieldErrorStyle}" />

            <TextBlock Text="Username on that host" Margin="0,8,0,2" />
            <TextBox x:Name="UserTextBox" />
            <TextBlock x:Name="UserError" Style="{StaticResource FieldErrorStyle}" />

            <TextBlock Text="Private key file (must already exist — Bosun does not create keys)" Margin="0,8,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="IdentityFileTextBox" Grid.Column="0" />
                <Button x:Name="BrowseIdentityFileButton" Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseIdentityFileClick" />
            </Grid>
            <TextBlock x:Name="IdentityFileError" Style="{StaticResource FieldErrorStyle}" />

            <Separator Margin="0,16,0,8" />
            <TextBlock Text="Mount" FontWeight="Bold" Margin="0,0,0,4" />

            <TextBlock Text="When to mount" Margin="0,4,0,2" />
            <ComboBox x:Name="ModeComboBox" SelectionChanged="OnModeSelectionChanged" />

            <StackPanel x:Name="MountDetailPanel">
                <TextBlock Text="Drive letter (D: to Z:)" Margin="0,8,0,2" />
                <ComboBox x:Name="DriveComboBox" DisplayMemberPath="Label">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <!-- Taken letters are shown but not selectable: hiding them makes a
                                 missing letter look like a bug, and the label says who has it. -->
                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock x:Name="DriveError" Style="{StaticResource FieldErrorStyle}" />

                <TextBlock Text="Folder on the host to mount (e.g. /home/you)" Margin="0,8,0,2" />
                <TextBox x:Name="RemotePathTextBox" />
                <TextBlock x:Name="RemotePathError" Style="{StaticResource FieldErrorStyle}" />

                <TextBlock Text="Write caching" Margin="0,8,0,2" />
                <ComboBox x:Name="VfsCacheModeComboBox" />
                <TextBlock x:Name="VfsCacheModeError" Style="{StaticResource FieldErrorStyle}" />

                <TextBlock Text="Mounted as a network drive (always — Windows mishandles SFTP shown as a local disk)"
                           Margin="0,8,0,2" Foreground="Gray" FontSize="11" />

                <TextBlock Text="Unmount after idle, in seconds (0 = never; on-demand hosts only)" Margin="0,8,0,2" />
                <TextBox x:Name="IdleUnmountSecondsTextBox" />
                <TextBlock x:Name="IdleUnmountSecondsError" Style="{StaticResource FieldErrorStyle}" />
            </StackPanel>

            <Separator Margin="0,16,0,8" />
            <TextBlock Text="Session" FontWeight="Bold" Margin="0,0,0,4" />

            <CheckBox x:Name="AutostartCheckBox" Content="Open a terminal for this host at login" Margin="0,4,0,0" />
            <CheckBox x:Name="ReconnectCheckBox" Content="Reconnect automatically if the SSH connection drops" Margin="0,4,0,0" />
            <CheckBox x:Name="TmuxCheckBox" Content="Attach to tmux" Margin="0,4,0,0" Checked="OnTmuxCheckedChanged" Unchecked="OnTmuxCheckedChanged" />

            <StackPanel x:Name="TmuxSessionPanel">
                <TextBlock Text="Tmux session name" Margin="0,8,0,2" />
                <TextBox x:Name="TmuxSessionTextBox" />
                <TextBlock x:Name="TmuxSessionError" Style="{StaticResource FieldErrorStyle}" />
            </StackPanel>

            <TextBlock Text="Terminal tab color (pick one, or type any #RRGGBB)" Margin="0,8,0,2" />
            <ItemsControl x:Name="TabColorPaletteItems" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="26" Height="26" Margin="0,0,4,4" Padding="0"
                                Background="{Binding Swatch}" ToolTip="{Binding Name}"
                                Tag="{Binding Hex}" Click="OnPaletteSwatchClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="TabColorSwatch" Grid.Column="0" Width="20" Height="20"
                        BorderBrush="#888888" BorderThickness="1" Margin="0,0,8,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="TabColorTextBox" Grid.Column="1" TextChanged="OnTabColorTextChanged" />
            </Grid>

            <TextBlock Text="Terminal color scheme" Margin="0,8,0,2" />
            <ComboBox x:Name="ColorSchemeComboBox" IsEditable="True" />

            <Separator Margin="0,16,0,8" />
            <TextBlock Text="Health checks" FontWeight="Bold" Margin="0,0,0,4" />

            <TextBlock Text="Check the host every N seconds while unmounted (0 = only when you ask)" Margin="0,4,0,2" />
            <TextBox x:Name="ProbeIntervalSecondsTextBox" />
            <TextBlock x:Name="ProbeIntervalSecondsError" Style="{StaticResource FieldErrorStyle}" />

            <CheckBox x:Name="DeepProbeCheckBox" Content="Verify SFTP really works, not just that the host answers" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save" Width="90" Click="OnSaveClick" IsDefault="True" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
