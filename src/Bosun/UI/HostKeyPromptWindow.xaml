<Window x:Class="Bosun.UI.HostKeyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New host" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/bosun.ico">
    <!--
        bs-ww9.8 / ADR-019: the first step of "Add Host": the key must exist before
        NewHostDefaults.Create can run (it picks the first free drive letter and needs a key to
        build the rest of the form around). Chrome only; key-uniqueness checking is done via
        HostEditorController.KeyAlreadyExists, which is unit-tested directly, not through this
        window.
    -->
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
            The key is the ~/.ssh/config Host alias Bosun's generated Terminal profile will run
            (ssh &lt;key&gt;, ADR-013). A key with no matching Host block will fail to launch with
            no explanation from Bosun.
        </TextBlock>
        <TextBox x:Name="KeyTextBox" TextChanged="OnKeyTextChanged" />
        <TextBlock x:Name="ErrorTextBlock" Foreground="#C0392B" FontSize="11" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="ContinueButton" Content="Continue" Width="90" Click="OnContinueClick" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
