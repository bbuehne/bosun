<Application x:Class="Bosun.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bosun"
             ShutdownMode="OnExplicitShutdown">
    <!--
        No StartupUri: ADR-018 makes Bosun a normal windowed app that lives in the tray, but
        launch context (autostart vs manual; see Bosun.UI.LaunchContextDetector) decides
        whether the window is shown at all, so App.xaml.cs constructs and conditionally shows
        MainWindow itself rather than declaring it here. ShutdownMode stays explicit: closing the
        window hides it to tray (never exits), and the tray icon (H.NotifyIcon) is the always-on
        surface for the steady state where no window is open.
    -->
    <Application.Resources>

    </Application.Resources>
</Application>
